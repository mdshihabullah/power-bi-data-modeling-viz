table CurrentDateTimeLocalTZ
	lineageTag: b1d98fcf-81e8-443a-80f1-d0878d3d2578

	measure 'Last Refresh' =
			
			VAR _refreshTime = MAX ( 'CurrentDateTimeLocalTZ'[LastRefresh])
			VAR _today = TODAY ()
			VAR _refreshDay = DATE ( YEAR ( _refreshTime ), MONTH ( _refreshTime ), DAY ( _refreshTime ) )
			VAR _daysDiff = DATEDIFF ( _refreshDay, _today, DAY )
			VAR _timePart = FORMAT ( _refreshTime, "HH:mm" )
			RETURN
			    "Updated " &
			    SWITCH (
			        TRUE (),
			        _daysDiff = 0,  "Today at " & _timePart,
			        _daysDiff = 1,  "Yesterday at " & _timePart,
			        _daysDiff < 365, FORMAT ( _refreshTime, "d MMM" ) & " at " & _timePart,
			        FORMAT ( _refreshTime, "d MMM yyyy" ) & " at " & _timePart
			    )
		lineageTag: 4a01dbc4-53e8-4f53-b186-ca80fed07454

	column LastRefresh
		dataType: dateTime
		formatString: General Date
		lineageTag: 0a0aef22-8145-483d-b77b-5d185db52897
		summarizeBy: none
		sourceColumn: LastRefresh

		variation Variation
			isDefault
			relationship: a5068915-67a0-4688-860f-bc34994afb85
			defaultHierarchy: LocalDateTable_f5871a70-4e7a-4467-b0c1-82d79494d2e8.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	partition CurrentDateTimeLocalTZ = m
		mode: import
		source =
				let
				    Source = DateTime.LocalNow(),
				    #"Converted to Table" = #table(1, {{Source}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Converted to Table",{{"Column1", "LastRefresh"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"LastRefresh", type datetime}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

